#!/usr/bin/env bash
# Pre-push checks: oxfmt, cargo fmt, tsc --noEmit, oxlint, cargo check.
# Aborts the push if any check fails. Enabled via `git config core.hooksPath .githooks`
# (done automatically by `pnpm install` through the "prepare" script).

set -u

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

status=0

run_check() {
  local name="$1"
  shift
  echo "==> $name"
  if ! "$@"; then
    echo "✗ $name failed"
    status=1
  else
    echo "✓ $name"
  fi
}

run_check "oxfmt --check" pnpm exec oxfmt --check
run_check "cargo fmt --check" cargo fmt --manifest-path src-tauri/Cargo.toml --check
run_check "tsc --noEmit" pnpm exec tsc --noEmit
run_check "oxlint" pnpm exec oxlint
run_check "cargo check" cargo check --manifest-path src-tauri/Cargo.toml

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Pre-push checks failed. Push aborted."
  echo "Run 'pnpm format && pnpm lint:fix' and 'cargo fmt --manifest-path src-tauri/Cargo.toml' to fix formatting/lint issues."
  exit 1
fi

exit 0
